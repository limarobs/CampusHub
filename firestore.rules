rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function createsStudentProfile() {
      return request.resource.data.keys().hasOnly([
        'displayName', 'email', 'role', 'createdAt'
      ]) && request.resource.data.role == 'STUDENT';
    }

    function preservesRole() {
      return !resource.data.keys().hasAll(['role'])
        || request.resource.data.role == resource.data.role;
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId) && createsStudentProfile();
      allow update: if ownsUser(userId)
          && preservesRole()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'email', 'updatedAt'
          ]);

      match /registrations/{eventId} {
        allow read, create, delete: if ownsUser(userId);
      }

      match /favorites/{eventId} {
        allow read, create, delete: if ownsUser(userId);
      }
    }

    match /events/{eventId} {
      allow read: if signedIn();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
            && request.resource.data.authorId == request.auth.uid;
        allow update: if signedIn()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }

      match /ratings/{userId} {
        allow read: if signedIn();
        allow create, update: if ownsUser(userId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/registrations/$(eventId));
      }
    }
  }
}
