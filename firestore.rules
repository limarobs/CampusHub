rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOrganizer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ORGANIZER';
    }

    function ownsEvent(eventData) {
      return isOrganizer()
        && eventData.keys().hasAll(['organizerId'])
        && eventData.organizerId == request.auth.uid;
    }

    function isPublishedEvent(eventData) {
      // Eventos antigos, sem status, continuam visíveis durante a migração.
      return !eventData.keys().hasAll(['status'])
        || eventData.status == 'PUBLISHED';
    }

    function canReadEvent(eventData) {
      return signedIn() && (isPublishedEvent(eventData) || ownsEvent(eventData));
    }

    function hasValidEventStatus(eventData) {
      return eventData.keys().hasAll(['status'])
        && eventData.status in ['DRAFT', 'PUBLISHED', 'CLOSED'];
    }

    function onlyEditsManagedEventFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'description', 'date', 'location', 'address', 'latitude', 'longitude',
        'category', 'startsAt', 'endsAt', 'status', 'capacity', 'coverImageUrl', 'updatedAt'
      ]);
    }

    function onlyEditsRegistrationCounters() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'confirmedCount', 'waitlistCount', 'updatedAt'
      ]);
    }

    function registrationDocument(eventId, userId) {
      return /databases/$(database)/documents/events/$(eventId)/registrations/$(userId);
    }

    function userRegistrationDocument(eventId, userId) {
      return /databases/$(database)/documents/users/$(userId)/registrations/$(eventId);
    }

    function isRegistrationCounterMutation(eventId) {
      let updatedEvent = request.resource.data;
      let currentEvent = resource.data;
      let ownRegistration = registrationDocument(eventId, request.auth.uid);
      let ownUserRegistration = userRegistrationDocument(eventId, request.auth.uid);
      return signedIn()
        && currentEvent.status == 'PUBLISHED'
        && onlyEditsRegistrationCounters()
        && (
          (
            existsAfter(ownRegistration)
            && existsAfter(ownUserRegistration)
            && getAfter(ownRegistration).data.status == 'CONFIRMED'
            && updatedEvent.confirmedCount == currentEvent.confirmedCount + 1
            && updatedEvent.waitlistCount == currentEvent.waitlistCount
            && updatedEvent.confirmedCount <= currentEvent.capacity
          )
          || (
            existsAfter(ownRegistration)
            && existsAfter(ownUserRegistration)
            && getAfter(ownRegistration).data.status == 'WAITLISTED'
            && updatedEvent.confirmedCount == currentEvent.confirmedCount
            && updatedEvent.waitlistCount == currentEvent.waitlistCount + 1
            && currentEvent.confirmedCount >= currentEvent.capacity
          )
          || (
            !existsAfter(ownRegistration)
            && !existsAfter(ownUserRegistration)
            && updatedEvent.confirmedCount == currentEvent.confirmedCount - 1
            && updatedEvent.waitlistCount == currentEvent.waitlistCount
            && currentEvent.waitlistCount == 0
          )
          || (
            !existsAfter(ownRegistration)
            && !existsAfter(ownUserRegistration)
            && updatedEvent.confirmedCount == currentEvent.confirmedCount
            && updatedEvent.waitlistCount == currentEvent.waitlistCount - 1
          )
        );
    }

    function createsStudentProfile() {
      return request.resource.data.keys().hasOnly([
        'displayName', 'email', 'role', 'createdAt'
      ]) && request.resource.data.role == 'STUDENT';
    }

    function preservesRole() {
      return !resource.data.keys().hasAll(['role'])
        || (
          request.resource.data.keys().hasAll(['role'])
          && request.resource.data.role == resource.data.role
        );
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId) && createsStudentProfile();
      allow update: if ownsUser(userId)
          && preservesRole()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'email', 'updatedAt'
          ]);

      // Mantido até o fluxo atômico de vagas migrar as inscrições para
      // events/{eventId}/registrations/{userId} no commit de capacidade.
      match /registrations/{eventId} {
        allow read: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
            && existsAfter(registrationDocument(eventId, userId))
            && getAfter(registrationDocument(eventId, userId)).data.attendeeId == userId
            && request.resource.data.status == getAfter(registrationDocument(eventId, userId)).data.status;
        allow delete: if ownsUser(userId)
            && (!exists(registrationDocument(eventId, userId))
              || !existsAfter(registrationDocument(eventId, userId)));
      }

      match /favorites/{eventId} {
        allow read, create, delete: if ownsUser(userId);
      }
    }

    match /events/{eventId} {
      allow read: if canReadEvent(resource.data);

      allow create: if ownsEvent(request.resource.data)
          && hasValidEventStatus(request.resource.data)
          && request.resource.data.status == 'DRAFT';

      allow update: if (
            ownsEvent(resource.data)
            && request.resource.data.organizerId == resource.data.organizerId
            && hasValidEventStatus(request.resource.data)
            && onlyEditsManagedEventFields()
          ) || isRegistrationCounterMutation(eventId);

      allow delete: if ownsEvent(resource.data);

      match /registrations/{attendeeId} {
        allow read: if signedIn()
            && canReadEvent(get(/databases/$(database)/documents/events/$(eventId)).data);

        allow create: if signedIn()
            && attendeeId == request.auth.uid
            && request.resource.data.attendeeId == request.auth.uid
            && existsAfter(userRegistrationDocument(eventId, attendeeId))
            && (
              (
                request.resource.data.status == 'CONFIRMED'
                && getAfter(/databases/$(database)/documents/events/$(eventId)).data.confirmedCount
                  == get(/databases/$(database)/documents/events/$(eventId)).data.confirmedCount + 1
              )
              || (
                request.resource.data.status == 'WAITLISTED'
                && getAfter(/databases/$(database)/documents/events/$(eventId)).data.waitlistCount
                  == get(/databases/$(database)/documents/events/$(eventId)).data.waitlistCount + 1
              )
            );

        allow delete: if signedIn()
            && attendeeId == request.auth.uid
            && !existsAfter(userRegistrationDocument(eventId, attendeeId))
            && (
              (
                resource.data.status == 'WAITLISTED'
                && getAfter(/databases/$(database)/documents/events/$(eventId)).data.waitlistCount
                  == get(/databases/$(database)/documents/events/$(eventId)).data.waitlistCount - 1
              )
              || (
                resource.data.status == 'CONFIRMED'
                && (
                  getAfter(/databases/$(database)/documents/events/$(eventId)).data.confirmedCount
                    == get(/databases/$(database)/documents/events/$(eventId)).data.confirmedCount - 1
                  || getAfter(/databases/$(database)/documents/events/$(eventId)).data.waitlistCount
                    == get(/databases/$(database)/documents/events/$(eventId)).data.waitlistCount - 1
                )
              )
            );

        allow update: if signedIn()
            && resource.data.status == 'WAITLISTED'
            && request.resource.data.status == 'CONFIRMED'
            && !existsAfter(userRegistrationDocument(eventId, request.auth.uid))
            && getAfter(/databases/$(database)/documents/events/$(eventId)).data.confirmedCount
              == get(/databases/$(database)/documents/events/$(eventId)).data.confirmedCount
            && getAfter(/databases/$(database)/documents/events/$(eventId)).data.waitlistCount
              == get(/databases/$(database)/documents/events/$(eventId)).data.waitlistCount - 1;
      }

      match /comments/{commentId} {
        allow read: if canReadEvent(get(/databases/$(database)/documents/events/$(eventId)).data);

        allow create: if canReadEvent(get(/databases/$(database)/documents/events/$(eventId)).data)
            && request.resource.data.authorId == request.auth.uid;

        allow update: if canReadEvent(get(/databases/$(database)/documents/events/$(eventId)).data)
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.authorName == resource.data.authorName
            && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if canReadEvent(get(/databases/$(database)/documents/events/$(eventId)).data)
            && resource.data.authorId == request.auth.uid;
      }

      match /ratings/{userId} {
        allow read: if canReadEvent(get(/databases/$(database)/documents/events/$(eventId)).data);

        allow create: if canReadEvent(get(/databases/$(database)/documents/events/$(eventId)).data)
            && userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/registrations/$(eventId))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/registrations/$(eventId)).data.status == 'CONFIRMED'
            && get(/databases/$(database)/documents/events/$(eventId)).data.endsAt <= request.time;

        allow update: if canReadEvent(get(/databases/$(database)/documents/events/$(eventId)).data)
            && userId == request.auth.uid
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/registrations/$(eventId))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/registrations/$(eventId)).data.status == 'CONFIRMED'
            && get(/databases/$(database)/documents/events/$(eventId)).data.endsAt <= request.time;
      }
    }
  }
}
